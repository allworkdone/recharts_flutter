{
 "name": "labellist-bar",
 "description": "Bar LabelLists: dataKey + top, label={position:center} in white, insideTop with fontSize 10.",
 "width": 600,
 "height": 300,
 "captureAnimation": [
  0,
  200,
  450,
  800
 ],
 "chart": {
  "type": "BarChart",
  "props": {
   "data": [
    {
     "name": "Page A",
     "uv": 4000,
     "pv": 2400,
     "amt": 2400
    },
    {
     "name": "Page B",
     "uv": 3000,
     "pv": 1398,
     "amt": 2210
    },
    {
     "name": "Page C",
     "uv": 2000,
     "pv": 9800,
     "amt": 2290
    },
    {
     "name": "Page D",
     "uv": 2780,
     "pv": 3908,
     "amt": 2000
    },
    {
     "name": "Page E",
     "uv": 1890,
     "pv": 4800,
     "amt": 2181
    }
   ],
   "margin": {
    "top": 20,
    "right": 30,
    "left": 20,
    "bottom": 5
   }
  },
  "children": [
   {
    "type": "CartesianGrid",
    "props": {
     "strokeDasharray": "3 3"
    }
   },
   {
    "type": "XAxis",
    "props": {
     "dataKey": "name"
    }
   },
   {
    "type": "YAxis",
    "props": {}
   },
   {
    "type": "Tooltip",
    "props": {}
   },
   {
    "type": "Bar",
    "props": {
     "dataKey": "pv",
     "fill": "#8884d8"
    },
    "children": [
     {
      "type": "LabelList",
      "props": {
       "dataKey": "pv",
       "position": "top"
      }
     }
    ]
   },
   {
    "type": "Bar",
    "props": {
     "dataKey": "uv",
     "fill": "#82ca9d",
     "label": {
      "position": "center",
      "fill": "#ffffff"
     }
    },
    "children": []
   },
   {
    "type": "Bar",
    "props": {
     "dataKey": "amt",
     "fill": "#ffc658"
    },
    "children": [
     {
      "type": "LabelList",
      "props": {
       "position": "insideTop",
       "fill": "#333333",
       "fontSize": 10
      }
     }
    ]
   }
  ]
 },
 "interactions": [
  {
   "id": "hover-b",
   "type": "hover",
   "x": 180,
   "y": 150
  },
  {
   "id": "hover-right",
   "type": "hover",
   "x": 560,
   "y": 150
  }
 ]
}