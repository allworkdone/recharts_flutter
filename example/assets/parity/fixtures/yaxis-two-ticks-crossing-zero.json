{
 "name": "yaxis-two-ticks-crossing-zero",
 "description": "YAxis tickCount 2 with data crossing zero gets the three ticks -10, 0, 10.",
 "width": 500,
 "height": 300,
 "chart": {
  "type": "LineChart",
  "props": {
   "margin": {
    "top": 5,
    "right": 30,
    "left": 20,
    "bottom": 5
   },
   "data": [
    {
     "name": "a",
     "pv": -10
    },
    {
     "name": "b",
     "pv": 10
    },
    {
     "name": "c",
     "pv": 4
    }
   ]
  },
  "children": [
   {
    "type": "CartesianGrid",
    "props": {
     "strokeDasharray": "3 3"
    }
   },
   {
    "type": "XAxis",
    "props": {
     "dataKey": "name"
    }
   },
   {
    "type": "YAxis",
    "props": {
     "domain": [
      "auto",
      "auto"
     ],
     "tickCount": 2
    }
   },
   {
    "type": "Line",
    "props": {
     "dataKey": "pv",
     "stroke": "#8884d8"
    }
   }
  ]
 },
 "interactions": []
}
