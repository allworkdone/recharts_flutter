{
 "name": "scatter-zaxis-bubble",
 "description": "Bubbles sized by ZAxis range [60, 900] with name and unit; red circle activeShape on hover.",
 "width": 500,
 "height": 300,
 "chart": {
  "type": "ScatterChart",
  "props": {
   "margin": {
    "top": 20,
    "right": 20,
    "bottom": 20,
    "left": 20
   }
  },
  "children": [
   {
    "type": "CartesianGrid",
    "props": {}
   },
   {
    "type": "XAxis",
    "props": {
     "type": "number",
     "dataKey": "x",
     "name": "stature",
     "unit": "cm"
    }
   },
   {
    "type": "YAxis",
    "props": {
     "type": "number",
     "dataKey": "y",
     "name": "weight",
     "unit": "kg"
    }
   },
   {
    "type": "ZAxis",
    "props": {
     "type": "number",
     "dataKey": "z",
     "range": [
      60,
      900
     ],
     "name": "score",
     "unit": "km"
    }
   },
   {
    "type": "Tooltip",
    "props": {
     "cursor": {
      "strokeDasharray": "3 3"
     }
    }
   },
   {
    "type": "Legend",
    "props": {}
   },
   {
    "type": "Scatter",
    "props": {
     "name": "A school",
     "data": [
      {
       "x": 100,
       "y": 200,
       "z": 200
      },
      {
       "x": 120,
       "y": 100,
       "z": 260
      },
      {
       "x": 170,
       "y": 300,
       "z": 400
      },
      {
       "x": 140,
       "y": 250,
       "z": 280
      },
      {
       "x": 150,
       "y": 400,
       "z": 500
      },
      {
       "x": 110,
       "y": 280,
       "z": 200
      }
     ],
     "fill": "#8884d8",
     "fillOpacity": 0.6,
     "stroke": "#5550aa",
     "activeShape": {
      "fill": "red"
     }
    }
   },
   {
    "type": "Scatter",
    "props": {
     "name": "B school",
     "data": [
      {
       "x": 200,
       "y": 260,
       "z": 240
      },
      {
       "x": 240,
       "y": 290,
       "z": 220
      },
      {
       "x": 190,
       "y": 290,
       "z": 250
      },
      {
       "x": 198,
       "y": 250,
       "z": 210
      },
      {
       "x": 180,
       "y": 280,
       "z": 260
      },
      {
       "x": 210,
       "y": 220,
       "z": 230
      }
     ],
     "fill": "#82ca9d",
     "fillOpacity": 0.6,
     "activeShape": {
      "fill": "red"
     }
    }
   }
  ]
 },
 "interactions": [
  {
   "id": "hover-point",
   "type": "hover",
   "x": 280,
   "y": 181
  },
  {
   "id": "hover-between",
   "type": "hover",
   "x": 150,
   "y": 200
  },
  {
   "id": "hover-right",
   "type": "hover",
   "x": 480,
   "y": 79
  },
  {
   "id": "hover-leave",
   "type": "hover",
   "x": 314,
   "y": 101,
   "then": [
    {
     "id": "off",
     "type": "hover",
     "x": 150,
     "y": 200
    }
   ]
  }
 ]
}
