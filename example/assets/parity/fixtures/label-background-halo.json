    },
    {
     "name": "Page B",
     "uv": 3000,
     "pv": 1398
    },
    {
     "name": "Page C",
     "uv": 2000,
     "pv": 5800
    },
    {
     "name": "Page D",
     "uv": 2780,
     "pv": 3908
    },
    {
     "name": "Page E",
     "uv": 1890,
