     "uv": 1000,
     "pv": 2400,
     "uvError": [
      75,
      20
     ],
     "pvError": [
      290,
      140
     ]
    },
    {
     "name": "Page B",
     "uv": 300,
     "pv": 4567,
     "uvError": [
      90,
      40
     ],
     "pvError": [
      175,
      320
     ]
    },
    {
     "name": "Page C",
     "uv": 280,
     "pv": 1398,
     "uvError": 40,
     "pvError": 220
    },
    {
     "name": "Page D",
     "uv": 200,
     "pv": 9800,
     "uvError": 20,
     "pvError": 280
    },
    {
     "name": "Page E",
     "uv": 278,
     "pv": 3908,
     "uvError": 28,
     "pvError": 400
    },
    {
